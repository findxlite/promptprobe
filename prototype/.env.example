# ===== PromptProbe 模型配置 =====
# 留空 LLM_API_KEY 时，产品自动进入「离线模拟演示模式」（被测模型为内置模拟器，
# 用于课堂现场演示与自测；结果会明确标注 SIMULATED）。
#
# 推荐：DeepSeek（OpenAI 兼容协议，价格低）
#   1) https://platform.deepseek.com/ 注册 → API keys → 创建
#   2) 填入下面的 LLM_API_KEY
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 攻击用例生成用的模型（缺省同 LLM_MODEL）
ATTACK_MODEL=
# 裁判模型（缺省同 LLM_MODEL）；建议与攻击模型不同，便于做交叉校准
JUDGE_MODEL=

# 可选：阿里云百炼 / 智谱 / Moonshot / OpenAI，均为 OpenAI 兼容协议
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 可选：本地 ollama（无需 key，先 `ollama serve`）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# 服务端口
PORT=8787
